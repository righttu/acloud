{
  "name": "acloud-mcp-s",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/verify.mjs && tsc --noEmit",
    "dryrun": "wrangler deploy --dry-run --outdir .dryrun",
    "deploy": "wrangler deploy && wrangler d1 migrations apply TICKETS_DB --remote",
    "seed": "node scripts/generate.mjs"
  },
  "dependencies": {
    "agents": "^0.33.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0",
    "@cloudflare/workers-types": "^5.20261106.1"
  },
  "cloudflare": {
    "bindings": {
      "ACLOUD_MCP_TOKEN": {
        "description": "程序侧 Bearer 密钥，请生成至少 32 字符随机值"
      }
    }
  }
}
